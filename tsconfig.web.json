{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "web/src",
    "outDir": "web/dist"
  },
  "include": ["web/src/**/*.ts"]
}
